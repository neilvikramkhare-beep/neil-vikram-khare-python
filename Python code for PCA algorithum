def transpose(X):
    res = [];
    for i in range(len(X[0])):
        row = [];
        for j in range(len(X)):
            row.append(X[j][i]);
        res.append(row);
    return res;
def dot(u, v):
    s = 0.0;
    for i in range(len(u)):
        s = s + u[i] * v[i];
    return s;
def matvec(A, v):
    res = [];
    for i in range(len(A)):
        res.append(dot(A[i], v));
    return res;
def matmul(A, B):
    B_T = transpose(B);
    res = [];
    for i in range(len(A)):
        row = [];
        for j in range(len(B_T)):
            row.append(dot(A[i], B_T[j]));
        res.append(row);
    return res;
def norm(v):
    s = 0.0;
    for i in range(len(v)):
        s = s + v[i] * v[i];
    return s ** 0.5;
def outer_product(u, v):
    res = [];
    for i in range(len(u)):
        row = [];
        for j in range(len(v)):
            row.append(u[i] * v[j]);
        res.append(row);
    return res;
def subtract_matrices(A, B):
    res = [];
    for i in range(len(A)):
        row = [];
        for j in range(len(A[0])):
            row.append(A[i][j] - B[i][j]);
        res.append(row);
    return res;
def mean_center(X):
    n = len(X);
    m = len(X[0]);
    means = [];
    for j in range(m):
        s = 0.0;
        for i in range(n):
            s = s + X[i][j];
        means.append(s / n);
    X_centered = [];
    for i in range(n):
        row = [];
        for j in range(m):
            row.append(X[i][j] - means[j]);
        X_centered.append(row);
    return X_centered;
def covariance_matrix(X):
    n = len(X);
    X_centered = mean_center(X);
    X_T = transpose(X_centered);
    cov = matmul(X_T, X_centered);
    for i in range(len(cov)):
        for j in range(len(cov[0])):
            cov[i][j] = cov[i][j] / (n - 1);
    return cov;
def power_iteration(A, num_iter):
    n = len(A);
    v = [];
    for i in range(n):
        v.append(1.0); 
    for i in range(num_iter):
        v_new = matvec(A, v);
        v_norm = norm(v_new);
        for j in range(n):
            v[j] = v_new[j] / v_norm;
    eigenvalue = dot(v, matvec(A, v));
    return eigenvalue, v;
def pca(X, k, num_iter):
    cov = covariance_matrix(X);
    eigenvectors = [];
    eigenvalues = [];
    A = cov;
    for i in range(k):
        eval, evec = power_iteration(A, num_iter);
        eigenvalues.append(eval);
        eigenvectors.append(evec);
        deflation_term = outer_product(evec, evec);
        for r in range(len(deflation_term)):
            for c in range(len(deflation_term[0])):
                deflation_term[r][c] = deflation_term[r][c] * eval;
        A = subtract_matrices(A, deflation_term);
    X_centered = mean_center(X);
    W = transpose(eigenvectors);
    X_reduced = matmul(X_centered, W);
    return X_reduced, eigenvectors, eigenvalues;
