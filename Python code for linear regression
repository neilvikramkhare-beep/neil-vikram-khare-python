import numpy as np
from sklearn.linear_model import LinearRegression
X = np.array([[1000], [1500], [2000], [2500], [3000]])
y = np.array([200000, 290000, 410000, 490000, 600000])
model = LinearRegression()
model.fit(X, y)
new_input = [[1800]]
prediction = model.predict(new_input)
print("Slope (m):", {model.coef_[0]:.2f})
print("Intercept (b):", {model.intercept.2f})
print("Prediction for new input:", ${prediction[0].2f})
print("R-squared score:", {model.score(X, y):.2f})
print("Mean squared error:", {np.mean((model.predict(X) - y) ** 2).2f})
print("Mean absolute error:", {np.mean(np.abs(model.predict(X) - y)).2f})
print("Standard deviation of residuals:", {np.std(model.predict(X) - y).2f})
