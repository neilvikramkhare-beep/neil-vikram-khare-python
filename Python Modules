def add(a,b):
    return a+b
def sub(a,b):
    return a-b
def mul(a,b):
    return a*b
def div(a,b):
    return a/b
def pow(a,b):
    return a**b
def mod(a,b):
    return a%b
def AddDiv(a,b):
    return (a+b)/2
def SubMul(a,b):
    return (a-b)*2
def max(a,b):
    if a>b:
        return a
    else:
        return b
def min(a,b):
    if a<b:
        return a
    else:
        return b
def abs(a):
    if a<0:
        return -a
    else:
        return a
def sqrt(a):
    return a**0.5
def factorial(n):
    if n==0:
        return 1
    else:
        return n*factorial(n-1)
def gcd(a,b):    
    while b:
        a, b = b, a % b
    return a
def lcm(a,b):
    return (a*b)//gcd(a,b)
def is_prime(n):
    if n<=1:
        return False
    for i in range(2,int(n**0.5)+1):
        if n%i==0:
            return False
    return True
def prime_factors(n):
    factors = []
    for i in range(2, int(n**0.5)+1):
        while n%i==0:
            factors.append(i)
            n//=i
    if n>1:
        factors.append(n)
    return factors
def ceil(a):
    if a==int(a):
        return int(a)
    else:
        return int(a)+1
def floor(a):
        return int(a)
